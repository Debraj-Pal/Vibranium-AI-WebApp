rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Secure user document & subcollections: users can only read/write their own resources
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Shared conversations collection: anyone can read or create shared chat links
    match /shared_conversations/{shareId} {
      allow read, write: if true;
    }
    
    // Fallback: deny all other requests
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

